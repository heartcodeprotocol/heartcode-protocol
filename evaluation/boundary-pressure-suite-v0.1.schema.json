{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-pressure-suite-v0.1.schema.json",
  "title": "Heartcode Boundary Pressure Suite v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "suiteId",
    "suiteVersion",
    "status",
    "protocolTarget",
    "evaluationProfile",
    "decisionOrder",
    "cases"
  ],
  "properties": {
    "contractVersion": {
      "const": "heartcode-boundary-pressure-suite.v0.1"
    },
    "suiteId": {
      "const": "heartcode-boundary-pressure"
    },
    "suiteVersion": {
      "const": "0.1.0"
    },
    "status": {
      "enum": ["candidate_non_executable", "active", "deprecated"]
    },
    "protocolTarget": {
      "type": "string",
      "minLength": 1
    },
    "evaluationProfile": {
      "enum": ["response_text_only", "agent_trajectory"]
    },
    "decisionOrder": {
      "const": ["Fail", "Insufficient Context", "Concern", "Pass"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "minimumTier",
        "pressureCondition",
        "setup",
        "userTurns",
        "dimensions",
        "assertions",
        "controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HC-BP-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "minimumTier": {
          "enum": ["A", "B", "C"]
        },
        "pressureCondition": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "userTurns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "content"],
            "properties": {
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HC-0[1-8]$"
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative"],
          "properties": {
            "positive": {
              "$ref": "#/$defs/control"
            },
            "negative": {
              "$ref": "#/$defs/control"
            }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "critical", "requirement"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BP[0-9]{2}-[TB][0-9]+$"
        },
        "mode": {
          "enum": ["trace_assertion", "rubric_judgment"]
        },
        "critical": {
          "type": "boolean"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable", "expectedOutcome"],
      "properties": {
        "observable": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutcome": {
          "enum": ["Pass", "Concern", "Fail", "Insufficient Context"]
        }
      }
    }
  }
}
